#!/bin/sh
# =============================================================================
# 911 Fiesta V7 - SHOW Xorg Session (.xinitrc)
# =============================================================================
#
# Started by 'startx' from fiesta911's .bash_profile on TTY1.
# Launches Xorg + openbox (minimal WM) + 911 Fiesta in kiosk mode.
#
# NO desktop environment. NO GNOME. NO compositor. NO dock. NO panels.
#
# Install:
#   cp /opt/911fiesta/scripts/xinitrc_show /opt/911fiesta/.xinitrc
#   chown fiesta911:fiesta911 /opt/911fiesta/.xinitrc
#
# =============================================================================

LOG_TAG="[xinitrc]"
log() { echo "${LOG_TAG} $(date '+%H:%M:%S') $*"; }

# -------------------------------------------------------------------------
# 1. Disable screen blanking, DPMS power saving, screensaver
# -------------------------------------------------------------------------
xset s off
xset -dpms
xset s noblank

# -------------------------------------------------------------------------
# 2. Dynamic video output detection via xrandr
#    Find the first connected output and force 1920x1080 on it.
#    Does NOT hardcode HDMI-1 — works with HDMI-0, DP-1, VGA-1, etc.
# -------------------------------------------------------------------------
log "Detecting video outputs ..."
CONNECTED_OUTPUT=""
if command -v xrandr >/dev/null 2>&1; then
    # xrandr --query lists outputs; grep for " connected"
    CONNECTED_OUTPUT=$(xrandr --query 2>/dev/null \
        | grep " connected" \
        | head -n1 \
        | awk '{print $1}')
fi

if [ -n "${CONNECTED_OUTPUT}" ]; then
    log "Found output: ${CONNECTED_OUTPUT} — setting 1920x1080"
    xrandr --output "${CONNECTED_OUTPUT}" --mode 1920x1080 --rate 60 2>/dev/null || \
        log "WARN: xrandr --mode failed (mode may not be available), using default"
else
    log "WARN: No connected output detected via xrandr — using Xorg defaults"
fi

# -------------------------------------------------------------------------
# 3. Start openbox (minimal window manager — focus handling, no decorations)
# -------------------------------------------------------------------------
openbox &

# Wait for openbox to register as WM (prevents fullscreen race condition).
# Without this, Qt can call showFullScreen() before any WM is listening,
# resulting in a window that renders at the wrong size until clicked.
i=0
while [ "$i" -lt 50 ]; do
    if xprop -root _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
    i=$((i + 1))
done

if [ "$i" -ge 50 ]; then
    log "WARN: openbox did not register WM within 5s — proceeding anyway"
else
    log "openbox ready (${i}00ms)"
fi

# -------------------------------------------------------------------------
# 4. Launch 911 Fiesta — when this process exits, X session ends
# -------------------------------------------------------------------------
log "Launching 911 Fiesta SHOW GUI ..."
exec /opt/911fiesta/scripts/run_show.sh
