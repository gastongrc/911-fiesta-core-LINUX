# 911 Fiesta V7 - VISION Dependencies (camera/detection/ML)
#
# Adds vision/ML packages on top of base.in.
# For headless Linux, use opencv-python-headless.
#
# USAGE:
#   pip-compile vision.in -o lock/vision.lock.txt --resolver=backtracking
#   pip install -r lock/vision.lock.txt
#
# NOTE: PyTorch GPU builds require a specific index URL.
#   CPU:  pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
#   CUDA: pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121

-r base.in

