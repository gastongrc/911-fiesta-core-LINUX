# =============================================================================
# 911 Fiesta V7 - Service Environment Configuration
# =============================================================================
#
# This file is read by systemd via EnvironmentFile= directive.
# Edit this file to change the entrypoint, port, or runtime behavior.
#
# After editing, restart the service:
#   sudo systemctl restart 911fiesta
#
# Installed to: /etc/911fiesta/911fiesta.env
# =============================================================================

# --- Entrypoint ---
# The command to run (relative to /opt/911fiesta/.venv/bin/).
#
# Server profile (headless API on port 8000):
FIESTA_EXEC_START=uvicorn api.main:app --host 0.0.0.0 --port 8000
#
# Show profile (GUI — requires DISPLAY and QT_QPA_PLATFORM=xcb):
#FIESTA_EXEC_START=python main.py
#
# Vision API only (Flask on port 5000):
#FIESTA_EXEC_START=python api_server.py

# --- Qt Platform ---
# offscreen = headless (no display required, default for server)
# xcb       = X11 display (required for GUI/show mode)
QT_QPA_PLATFORM=offscreen

# --- CUDA / GPU ---
# Uncomment to pin a specific CUDA device (multi-GPU systems)
#CUDA_VISIBLE_DEVICES=0
