# 911 Fiesta V7 - Systemd Service Unit (SERVER / headless API)
#
# Installed by: scripts/install_911fiesta.sh
# Destination:  /etc/systemd/system/911fiesta.service
#
# This unit runs the FastAPI/uvicorn API server (headless, no GUI).
# For the SHOW GUI entrypoint, see docs/SHOW_RUNBOOK.md (XDG autostart).
#
# Configuration:
#   /etc/911fiesta/911fiesta.env  (port, log level, runtime overrides)
#
# Usage:
#   systemctl start  911fiesta
#   systemctl stop   911fiesta
#   systemctl status 911fiesta
#   journalctl -u 911fiesta -f

[Unit]
Description=911 Fiesta V7 - API Server (headless)
After=network-online.target graphical-session.target
Wants=network-online.target
# Rate-limit restarts (must be in [Unit] for systemd < 250 / Ubuntu 22.04)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=fiesta911
Group=fiesta911

WorkingDirectory=/opt/911fiesta

# --- Environment ---
Environment="PATH=/opt/911fiesta/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="QT_QPA_PLATFORM=offscreen"

# Configurable overrides (port, log level, etc.)
EnvironmentFile=/etc/911fiesta/911fiesta.env

# --- Entrypoint ---
# Wait for GNOME compositor before launching (avoids race condition on SHOW)
ExecStartPre=/bin/sleep 3
# Fixed command — no ${VAR} expansion (systemd treats it as one token).
# To change host/port, edit /etc/911fiesta/911fiesta.env and use
# UVICORN_HOST / UVICORN_PORT, or override ExecStart via drop-in.
ExecStart=/opt/911fiesta/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000

# --- Restart Policy ---
Restart=on-failure
RestartSec=5

# --- Resource Limits ---
LimitNOFILE=65536
LimitNPROC=4096

# --- Logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=911fiesta

# --- Security Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/911fiesta /etc/911fiesta /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
