# 911 Fiesta V7 - SHOW Kiosk Target
#
# Custom systemd target for SHOW machines.
# Boots to multi-user + Xorg + app, WITHOUT any desktop environment.
#
# Boot chain:
#   BIOS → systemd → show.target (default)
#     → multi-user.target
#       → getty@tty1 (autologin fiesta911)
#         → .bash_profile → startx
#           → .xinitrc → openbox → 911 Fiesta
#
# Activate:
#   sudo systemctl set-default show.target
#
# Revert to GNOME desktop:
#   sudo systemctl set-default graphical.target
#   sudo systemctl enable gdm
#   sudo reboot

[Unit]
Description=911 Fiesta SHOW Kiosk
Requires=multi-user.target
After=multi-user.target
Conflicts=graphical.target
AllowIsolate=yes
